# Configurazione Database PostgreSQL
# Per sviluppo locale, usa questi parametri:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestionale_termoidraulico
DB_USER=postgres
DB_PASSWORD=password

# Per produzione (Railway/Render), usa DATABASE_URL:
# DATABASE_URL=postgresql://username:password@host:port/database

# Configurazione JWT
JWT_SECRET=your_super_secret_jwt_key_here_change_this_in_production
JWT_EXPIRES_IN=24h

# Configurazione Crittografia
ENCRYPTION_KEY=your_32_char_encryption_key_123456

# Configurazione Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Configurazione Bcrypt
BCRYPT_ROUNDS=12

# Configurazione Server
PORT=3000
NODE_ENV=development

# CORS Origins (per produzione)
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
